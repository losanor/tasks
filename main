from telegram.ext import ApplicationBuilder, CommandHandler, ConversationHandler, CallbackQueryHandler, MessageHandler, filters
from handlers_cadastro import nova_tarefa, receber_nome, receber_urgencia, receber_importancia, confirmar_tarefa, cancelar
from handlers_tarefas import listar_tarefas, acao_callback
from handlers_relatorios import relatorio
from dotenv import load_dotenv
import os

# ===== Setup do Bot =====
load_dotenv()
TELEGRAM_TOKEN = os.getenv("TELEGRAM_TOKEN")

app = ApplicationBuilder().token(TELEGRAM_TOKEN).build()

NOME, URGENTE, IMPORTANTE, CONFIRMACAO = range(4)

conversacao = ConversationHandler(
    entry_points=[CommandHandler("nova", nova_tarefa)],
    states={
        NOME: [MessageHandler(filters.TEXT & ~filters.COMMAND, receber_nome)],
        URGENTE: [CallbackQueryHandler(receber_urgencia)],
        IMPORTANTE: [CallbackQueryHandler(receber_importancia)],
        CONFIRMACAO: [CallbackQueryHandler(confirmar_tarefa, pattern="^confirmar$"),
                      CallbackQueryHandler(cancelar, pattern="^cancelar$")],
    },
    fallbacks=[]
)

app.add_handler(CommandHandler("start", nova_tarefa))
app.add_handler(conversacao)
app.add_handler(CommandHandler("listar", listar_tarefas))
app.add_handler(CommandHandler("relatorio", relatorio))
app.add_handler(CallbackQueryHandler(acao_callback, pattern="^(concluir_|postergar_).*$"))

if __name__ == '__main__':
    app.run_polling()
